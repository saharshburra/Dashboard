// use prisma-8

model Source {
  id        Int      @id @default(autoincrement())
  websiteUrl      String   @unique
  category String
  name     String
  rssUrl     String
  articles   Article[]
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  url      String   @unique
  description String?
  simplifiedTitle String?
  summary   String?
  worthReading Boolean?
  relevanceScore Float?
  publishedAt TimestamptzString
  processedAt TimestamptzString?
  fetchedAt   TimestamptzString @default(now())
  source    Source   @relation(fields: [sourceId], references: [id])
  sourceId  Int
}
